# Signs SRS return paths. Keep it stable: changing it invalidates the return
# paths of mail forwarded in the last few days.
MAIL_API_SECRET="your-mail-api-secret-here"

# Postgres connection string for the same database the website uses.
# The mail server reads aliases/recipients/domains and writes alias stats directly.
# Remote hosts use TLS without certificate verification (like the website); an
# explicit ?sslmode= overrides that — note that node-postgres treats
# sslmode=require as verify-full.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Required: same value as the website's DKIM_ENCRYPTION_KEY (64 hex characters).
# Custom-domain DKIM keys are stored encrypted with it.
DKIM_ENCRYPTION_KEY=""

# Upstash Redis (rate limits, reply and bounce tokens, reply Message-ID map).
# Without it everything falls back to in-memory state, which does not survive a
# restart — set it in production.
UPSTASH_REDIS_REST_URL="https://example-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="example-token"

# TLS: place the combined key + chain at config/tls/anon.li.pem (mode 0600):
#   cat privkey.pem fullchain.pem > config/tls/anon.li.pem
#
# DKIM keys live in config/dkim/<domain>/private.
# Generate with: ./scripts/generate-dkim.sh <domain>
# Both are mounted into the container and staged into haraka-owned copies at
# startup, so the host files can stay owner-only.
DKIM_REQUIRED_DOMAINS="anon.li reply.anon.li"
